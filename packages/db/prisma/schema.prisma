// Modelos completos según el ERD consolidado (CONTEXTO_PROYECTO.md §7) más las
// tablas de seguridad del §3 (SesionRefresh, LogLogin, LogIntentoNoAutorizado),
// agregadas explícitamente y ya reflejadas también en el ERD Mermaid del .md.
//
// Convención de nombres (confirmada con el owner del proyecto):
// - Modelos Prisma: PascalCase, singular (Usuario, LecturaBalance).
// - Campos Prisma: camelCase (clienteId), mapeados a snake_case singular en la
//   columna física (cliente_id) vía @map.
// - Tablas físicas: snake_case, primera palabra del nombre en plural
//   (usuarios, lecturas_balance, regiones_operativa) vía @@map.
// - Tipos `string` del ERD -> String (Postgres `text`, sin límite de longitud
//   arbitrario). Tipos `enum` del ERD -> enum nativo de Postgres. La única
//   excepción es `tipo_corte` (LECTURA_BALANCE, QUEMA_NACIONAL): el ERD lo
//   declara `string`, pero la lista está cerrada a exactamente 2 valores
//   (PUNTUAL, CIERRE_PROMEDIO), así que se implementó como enum.
// - Mecánica real de PUNTUAL/CIERRE_PROMEDIO (decisión #34, corrige la #2 y
//   la #14): PUNTUAL se corrige varias veces al día -> cada corrección genera
//   una fila en su *_HISTORIAL (LecturaBalanceHistorial / QuemaNacionalHistorial).
//   CIERRE_PROMEDIO se calcula como media aritmética SIMPLE (no ponderada por
//   tiempo) de todos los valores que tuvo el PUNTUAL ese día (historial + valor
//   final vigente) y SÍ se guarda como fila propia (alimenta el informe de
//   cierre) - a diferencia de "Balance Nación", que es query-calculado. El
//   PUNTUAL del día siguiente arranca con el último valor del día anterior
//   (carry-forward); esta parte del proceso vive en el Service, no en el schema.
// - `numeric` sin precisión especificada en el ERD -> Decimal(14,4) para
//   volúmenes de gas (mmpced), Decimal(10,2) para horas-hombre (hh).
//
// Pendiente de negocio (NO resuelto aquí, ver CONTEXTO_PROYECTO.md §9.2 #4):
// NOVEDAD_OPERATIVA.tipo se dejó como String simple (no enum ni catálogo)
// porque la lista de valores todavía no está cerrada.
//
// Pendiente de implementación: los CHECK "exactamente uno de cliente_id/
// fuente_id" en NovedadOperativa y Contacto no se pueden declarar en
// schema.prisma — hay que agregarlos a mano al SQL de la primera migración
// (`prisma migrate dev --create-only`) antes de aplicarla.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Postgres local en Docker (decisión #40) - misma URL para runtime y
  // migraciones (ver .env y docker-compose.yml).
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector, unaccent]
}

// ===== ENUMS =====

enum TipoCorte {
  PUNTUAL
  CIERRE_PROMEDIO

  @@map("tipo_corte")
}

enum TipoRed {
  TRANSPORTE   @map("T")
  DISTRIBUCION @map("D")

  @@map("tipo_red")
}

// ===== DOMINIO A: DESPACHO =====

model RegionOperativa {
  id     Int    @id @default(autoincrement())
  nombre String

  clientes Cliente[]

  @@map("regiones_operativa")
}

model Sistema {
  id     Int    @id @default(autoincrement())
  nombre String

  fuentes             Fuente[]
  clientes            Cliente[]
  subSistemas         SubSistema[]
  puntosTransferencia PuntoTransferencia[]

  @@map("sistemas")
}

// Subdivision de un SISTEMA: una rama del gasoducto que el area reporta
// aparte. El Manual DAO usa el termino "Sub Sistema" (diapositiva 57) y la
// hoja CEN-ORI del balance agrupa sus clientes en bloques que se corresponden
// con estas ramas.
//
// Cuelga de SISTEMA y no de REGION a proposito: Costa Oeste y Costa Este son
// las dos de Occidente y del mismo sistema Ule-Amuay, asi que la region no las
// separa. Ver decision #78.
model SubSistema {
  id        Int    @id @default(autoincrement())
  sistemaId Int    @map("sistema_id")
  // Unico dentro de su sistema, no a nivel nacional: dos sistemas distintos
  // podrian tener una rama con el mismo nombre generico.
  nombre    String

  sistema             Sistema              @relation(fields: [sistemaId], references: [id])
  clientes            Cliente[]
  puntosTransferencia PuntoTransferencia[]

  @@unique([sistemaId, nombre])
  @@map("sub_sistemas")
}

model Cliente {
  id           Int    @id @default(autoincrement())
  regionId     Int    @map("region_id")
  sistemaId    Int    @map("sistema_id")
  sectorId     Int    @map("sector_id")
  // Nullable: no todo sistema esta subdividido. Nulo significa "este cliente
  // cuelga directo de su sistema" (decision #78).
  subSistemaId Int?   @map("sub_sistema_id")
  // Unico a nivel nacional: el nombre es como el area identifica al cliente, y
  // la grilla diaria es una fila por cliente - dos filas iguales no se podrian
  // distinguir al digitar. Los 111 clientes reales ya cumplen.
  nombre       String @unique

  region             RegionOperativa    @relation(fields: [regionId], references: [id])
  sistema            Sistema            @relation(fields: [sistemaId], references: [id])
  sector             SectorCliente      @relation(fields: [sectorId], references: [id])
  subSistema         SubSistema?        @relation(fields: [subSistemaId], references: [id])
  lecturasBalance    LecturaBalance[]
  novedadesOperativa NovedadOperativa[]
  contactos          Contacto[]

  @@map("clientes")
}

// Catálogo editable (patrón de la decisión #31/#32): antes era CLIENTE.tipo_sector
// como String libre; la auditoría de NUEVO_BALANCE_ACTUALIZADO.xlsm (tabla
// "CONSUMO POR SECTORES") reveló una lista real de valores de negocio (Empresa
// Mixta + 6 sectores económicos) que crece con el tiempo - mismo riesgo de
// typos que motivó convertir INSUMO/ESTADO_TELEMETRIA en catálogo.
model SectorCliente {
  id     Int     @id @default(autoincrement())
  // El constraint cubre tambien las filas desactivadas: reusar el nombre de un
  // sector dado de baja haria ambiguos los reportes historicos, que es
  // justamente lo que el soft-delete existe para evitar.
  nombre String  @unique
  activo Boolean @default(true)

  clientes Cliente[]

  @@map("sectores_cliente")
}

model Fuente {
  id         Int     @id @default(autoincrement())
  sistemaId  Int     @map("sistema_id")
  // Mismo criterio que CLIENTE. Unico a nivel nacional y no por sistema: el
  // catalogo real ya trae el sistema en el nombre cuando hace falta
  // distinguir (decision #39). Las 31 fuentes reales ya cumplen.
  nombre     String  @unique
  // Plantas que procesan gas (San Joaquín, Santa Bárbara, Jusepín, El
  // Tablazo LGN1/LGN2 — decisión pendiente de numerar): tienen un dato de
  // "procesado" además del volumen que entra al balance. El resto de las
  // fuentes (entregas directas, empresas mixtas) no procesan nada, sólo
  // entregan, y no muestran ese campo.
  procesaGas Boolean @default(false) @map("procesa_gas")

  sistema            Sistema            @relation(fields: [sistemaId], references: [id])
  lecturasFuente     LecturaFuente[]
  novedadesOperativa NovedadOperativa[]
  contactos          Contacto[]

  @@map("fuentes")
}

// Punto por el que el gas sale del sistema sin ser consumo de un cliente: un
// aporte a otra division (E&P) o una transferencia a otro sistema.
//
// Existe porque el workbook los lleva como filas dentro del bloque de clientes
// y los cuenta en su TOTAL VENTAS, pero la decision #46 los saco del catalogo
// CLIENTE con razon: no son clientes. Excluirlos del todo dejaba el
// transportado 8 MMPCED corto contra el Excel. Decision #79.
model PuntoTransferencia {
  id            Int     @id @default(autoincrement())
  sistemaId     Int     @map("sistema_id")
  // Donde lo cuenta el balance. Nulo cuando el sistema no esta subdividido.
  subSistemaId  Int?    @map("sub_sistema_id")
  nombre        String
  // A donde va: "EYP", "NURGAS". Texto libre por ahora, son dos valores.
  destino       String
  // Cuando es true el volumen admite signo: positivo en el sentido que nombra
  // `nombre`, negativo en el contrario. Es el caso de ICO-NURGAS, que el
  // workbook resuelve exactamente asi (FUENTES!Q31).
  bidireccional Boolean @default(false)

  sistema    Sistema                @relation(fields: [sistemaId], references: [id])
  subSistema SubSistema?            @relation(fields: [subSistemaId], references: [id])
  lecturas   LecturaTransferencia[]

  @@unique([sistemaId, nombre])
  @@map("puntos_transferencia")
}

// Misma mecanica que LECTURA_BALANCE: dos cortes, historial obligatorio de
// correcciones (decision #3) y un valor por punto, fecha y corte.
//
// A diferencia de las demas lecturas, `mmpced` **admite negativos** cuando el
// punto es bidireccional.
model LecturaTransferencia {
  id        BigInt    @id @default(autoincrement())
  puntoId   Int       @map("punto_id")
  fecha     DateTime  @db.Date
  tipoCorte TipoCorte @map("tipo_corte")
  mmpced    Decimal   @db.Decimal(14, 4)
  usuarioId Int       @map("usuario_id")

  punto     PuntoTransferencia              @relation(fields: [puntoId], references: [id])
  usuario   Usuario                         @relation(fields: [usuarioId], references: [id])
  historial LecturaTransferenciaHistorial[]

  @@unique([puntoId, fecha, tipoCorte])
  @@index([fecha])
  @@map("lecturas_transferencia")
}

model LecturaTransferenciaHistorial {
  id           BigInt   @id @default(autoincrement())
  lecturaId    BigInt   @map("lectura_id")
  mmpcedAnt    Decimal  @map("mmpced_ant") @db.Decimal(14, 4)
  usuarioId    Int      @map("usuario_id")
  modificadoEn DateTime @default(now()) @map("modificado_en")

  lectura LecturaTransferencia @relation(fields: [lecturaId], references: [id], onDelete: Cascade)
  usuario Usuario              @relation(fields: [usuarioId], references: [id])

  @@map("lecturas_transferencia_historial")
}

model LecturaBalance {
  id            BigInt    @id @default(autoincrement())
  clienteId     Int       @map("cliente_id")
  fecha         DateTime  @db.Date
  tipoCorte     TipoCorte @map("tipo_corte")
  volumenMmpced Decimal   @map("volumen_mmpced") @db.Decimal(14, 4)
  // Hora real de la lectura en planta, no la de digitación: el dato llega
  // desfasado y el analista quiere dejar constancia de cuándo ocurrió la
  // medición. Nullable y sin CIERRE_PROMEDIO (decisión pendiente de numerar) —
  // una media no tiene una sola hora.
  horaLectura   DateTime? @map("hora_lectura") @db.Time
  usuarioId     Int       @map("usuario_id")
  // El valor vigente también se puede corregir en el lugar desde la
  // cuadrícula del historial, sin generar una corrección (misma decisión
  // pendiente de numerar que `LecturaBalanceHistorial.editadoPorId`). A
  // diferencia del PATCH normal, ese camino **no** baja el valor viejo al
  // historial: justamente para que un número mal tecleado no entre en la
  // media del CIERRE_PROMEDIO. `usuarioId` sigue siendo quien lo fijó; esto
  // es quién lo retocó después.
  editadoPorId  Int?      @map("editado_por_id")
  editadoEn     DateTime? @map("editado_en")

  cliente    Cliente                   @relation(fields: [clienteId], references: [id])
  usuario    Usuario                   @relation("LecturaBalanceDigitadaPor", fields: [usuarioId], references: [id])
  editadoPor Usuario?                  @relation("LecturaBalanceEditadaPor", fields: [editadoPorId], references: [id])
  historial  LecturaBalanceHistorial[]

  @@unique([clienteId, fecha, tipoCorte])
  @@index([fecha])
  @@map("lecturas_balance")
}

model LecturaBalanceHistorial {
  id               BigInt    @id @default(autoincrement())
  lecturaId        BigInt    @map("lectura_id")
  volumenMmpcedAnt Decimal   @map("volumen_mmpced_ant") @db.Decimal(14, 4)
  horaLecturaAnt   DateTime? @map("hora_lectura_ant") @db.Time
  // Un valor del historial se puede corregir después (decisión pendiente de
  // numerar): si el analista tecleó 500 por error, ese 500 entraba igual en
  // la media del CIERRE_PROMEDIO (decisión #34) aunque lo hubiera corregido
  // enseguida. Editarlo **pisa** el número original, así que esto amplía la
  // decisión #3: el historial deja de ser inmutable y a cambio guarda quién
  // lo retocó y cuándo, que es el rastro que queda.
  editadoPorId     Int?      @map("editado_por_id")
  editadoEn        DateTime? @map("editado_en")
  usuarioId        Int       @map("usuario_id")
  modificadoEn     DateTime  @default(now()) @map("modificado_en")

  lectura    LecturaBalance @relation(fields: [lecturaId], references: [id], onDelete: Cascade)
  usuario    Usuario        @relation("LecturaBalanceHistorialCorrigio", fields: [usuarioId], references: [id])
  editadoPor Usuario?       @relation("LecturaBalanceHistorialEditadoPor", fields: [editadoPorId], references: [id])

  @@map("lecturas_balance_historial")
}

model LecturaFuente {
  id            BigInt    @id @default(autoincrement())
  fuenteId      Int       @map("fuente_id")
  fecha         DateTime  @db.Date
  volumenMmpced Decimal   @map("volumen_mmpced") @db.Decimal(14, 4)
  horaLectura   DateTime? @map("hora_lectura") @db.Time
  usuarioId     Int       @map("usuario_id")
  // Sólo para fuentes con `procesaGas`. Informativo: no entra en ningún
  // cálculo del balance (recibido sigue siendo `volumenMmpced`, decisiones
  // #62/#74) — el owner lo pidió igual porque el área lo registra en el
  // workbook real y perderlo sería un retroceso frente al Excel.
  procesado     Decimal?  @db.Decimal(14, 4)

  fuente    Fuente                   @relation(fields: [fuenteId], references: [id])
  usuario   Usuario                  @relation(fields: [usuarioId], references: [id])
  historial LecturaFuenteHistorial[]

  @@unique([fuenteId, fecha])
  @@index([fecha])
  @@map("lecturas_fuente")
}

model LecturaFuenteHistorial {
  id               BigInt    @id @default(autoincrement())
  lecturaFuenteId  BigInt    @map("lectura_fuente_id")
  volumenMmpcedAnt Decimal   @map("volumen_mmpced_ant") @db.Decimal(14, 4)
  horaLecturaAnt   DateTime? @map("hora_lectura_ant") @db.Time
  procesadoAnt     Decimal?  @map("procesado_ant") @db.Decimal(14, 4)
  usuarioId        Int       @map("usuario_id")
  modificadoEn     DateTime  @default(now()) @map("modificado_en")

  lecturaFuente LecturaFuente @relation(fields: [lecturaFuenteId], references: [id], onDelete: Cascade)
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])

  @@map("lecturas_fuente_historial")
}

model QuemaNacional {
  id           BigInt    @id @default(autoincrement())
  fecha        DateTime  @db.Date
  tipoCorte    TipoCorte @map("tipo_corte")
  mmpced       Decimal   @db.Decimal(14, 4)
  horaLectura  DateTime? @map("hora_lectura") @db.Time
  usuarioId    Int       @map("usuario_id")
  // Ver `LecturaBalance.editadoPorId`.
  editadoPorId Int?      @map("editado_por_id")
  editadoEn    DateTime? @map("editado_en")

  usuario    Usuario                  @relation("QuemaNacionalDigitadaPor", fields: [usuarioId], references: [id])
  editadoPor Usuario?                 @relation("QuemaNacionalEditadaPor", fields: [editadoPorId], references: [id])
  historial  QuemaNacionalHistorial[]

  @@unique([fecha, tipoCorte])
  @@map("quemas_nacional")
}

// Agregada junto con la decisión #34: el PUNTUAL de Quema Nacional también se
// corrige varias veces al día y cada corrección debe quedar en historial, igual
// que LecturaBalance - el CIERRE_PROMEDIO se sigue guardando como fila propia en
// QuemaNacional (arriba), calculado como media simple de este historial + el
// valor final vigente del día.
model QuemaNacionalHistorial {
  id              BigInt    @id @default(autoincrement())
  quemaNacionalId BigInt    @map("quema_nacional_id")
  mmpcedAnt       Decimal   @map("mmpced_ant") @db.Decimal(14, 4)
  horaLecturaAnt  DateTime? @map("hora_lectura_ant") @db.Time
  // Mismo criterio que `LecturaBalanceHistorial.editadoPorId`.
  editadoPorId    Int?      @map("editado_por_id")
  editadoEn       DateTime? @map("editado_en")
  usuarioId       Int       @map("usuario_id")
  modificadoEn    DateTime  @default(now()) @map("modificado_en")

  quemaNacional QuemaNacional @relation(fields: [quemaNacionalId], references: [id], onDelete: Cascade)
  usuario       Usuario       @relation("QuemaNacionalHistorialCorrigio", fields: [usuarioId], references: [id])
  editadoPor    Usuario?      @relation("QuemaNacionalHistorialEditadoPor", fields: [editadoPorId], references: [id])

  @@map("quemas_nacional_historial")
}

model NovedadOperativa {
  id              BigInt    @id @default(autoincrement())
  // Exactamente uno de clienteId/fuenteId debe estar presente.
  // CHECK pendiente de agregar a mano en la migración SQL inicial.
  clienteId       Int?      @map("cliente_id")
  fuenteId        Int?      @map("fuente_id")
  // Lista de valores aún no cerrada (CONTEXTO_PROYECTO.md §9.2 #4) - String simple por ahora.
  tipo            String
  impacto         String
  inicio          DateTime
  fin             DateTime?
  causa           String
  mmpcedAfectados Decimal   @map("mmpced_afectados") @db.Decimal(14, 4)
  usuarioId       Int       @map("usuario_id")

  cliente Cliente? @relation(fields: [clienteId], references: [id])
  fuente  Fuente?  @relation(fields: [fuenteId], references: [id])
  usuario Usuario  @relation(fields: [usuarioId], references: [id])

  // Sólo del lado de Prisma: la columna vive en chunks_rag (decisión #102),
  // la tabla de novedades no cambia.
  chunkRag ChunkRag?

  @@map("novedades_operativa")
}

model Contacto {
  id             Int    @id @default(autoincrement())
  // Exactamente uno de clienteId/fuenteId debe estar presente.
  // CHECK pendiente de agregar a mano en la migración SQL inicial.
  clienteId      Int?   @map("cliente_id")
  fuenteId       Int?   @map("fuente_id")
  nombreOperador String @map("nombre_operador")
  telefono       String

  cliente Cliente? @relation(fields: [clienteId], references: [id])
  fuente  Fuente?  @relation(fields: [fuenteId], references: [id])

  @@map("contactos")
}

// ===== DOMINIO B: MANTENIMIENTO =====

model RegionMtto {
  id     Int    @id @default(autoincrement())
  nombre String

  areas               AreaMtto[]
  actividadesRegistro ActividadRegistro[]

  @@map("regiones_mtto")
}

model AreaMtto {
  id       Int    @id @default(autoincrement())
  regionId Int    @map("region_id")
  nombre   String

  region     RegionMtto @relation(fields: [regionId], references: [id])
  estaciones Estacion[]

  @@map("areas_mtto")
}

model Estacion {
  id            Int      @id @default(autoincrement())
  areaId        Int      @map("area_id")
  nombre        String
  nodo          String   @unique
  // Catálogo cerrado real: "IP PDVSA" | "SATELITAL" | "SERIAL PDVSA".
  // El ERD lo declara `string` (no enum), se respeta tal cual; validar la
  // lista cerrada en shared-validators (zod) del lado de la aplicación.
  tipoEnlaceCom String   @map("tipo_enlace_com")
  // Opcional: 3 de las 247 estaciones del inventario real no están clasificadas
  // ni como transporte ni como distribución, y sí cuentan en el total de la
  // disponibilidad semanal. Clasificarlas a dedo movería el indicador.
  tipoRed       TipoRed? @map("tipo_red")

  area         AreaMtto              @relation(fields: [areaId], references: [id])
  instrumentos EstacionInstrumento[]
  fallas       FallaEstacion[]

  @@map("estaciones")
}

model TipoInstrumento {
  id     Int    @id @default(autoincrement())
  nombre String

  instrumentos EstacionInstrumento[]

  @@map("tipos_instrumento")
}

model EstacionInstrumento {
  id                Int @id @default(autoincrement())
  estacionId        Int @map("estacion_id")
  tipoInstrumentoId Int @map("tipo_instrumento_id")
  cantidad          Int

  estacion        Estacion        @relation(fields: [estacionId], references: [id], onDelete: Cascade)
  tipoInstrumento TipoInstrumento @relation(fields: [tipoInstrumentoId], references: [id])

  @@map("estaciones_instrumento")
}

model CausaFalla {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  fallas FallaEstacion[]

  @@map("causas_falla")
}

// Una fila por interrupción, no una por estación y semana: en el archivo real
// las fallas llevan años abiertas (la más vieja arranca en 2011) y el área las
// anota una sola vez, cuando empiezan. La disponibilidad de cualquier fecha es
// una consulta sobre este rango, no un dato que alguien digite.
model FallaEstacion {
  id                BigInt    @id @default(autoincrement())
  estacionId        Int       @map("estacion_id")
  causaFallaId      Int       @map("causa_falla_id")
  desde             DateTime  @db.Date
  resueltaEn        DateTime? @map("resuelta_en") @db.Date
  observacion       String?
  usuarioId         Int       @map("usuario_id")
  // Quien la resolvió, distinto de quien la abrió (§15.5, decisión pendiente
  // resuelta el 2026-09-21). Nullable porque una falla abierta no tiene
  // resolutor todavía, y las fallas ya resueltas antes de esta columna no
  // tienen cómo saberlo.
  usuarioResolvioId Int?      @map("usuario_resolvio_id")

  estacion        Estacion                 @relation(fields: [estacionId], references: [id])
  causaFalla      CausaFalla               @relation(fields: [causaFallaId], references: [id])
  usuario         Usuario                  @relation("FallaEstacionAbiertaPor", fields: [usuarioId], references: [id])
  usuarioResolvio Usuario?                 @relation("FallaEstacionResueltaPor", fields: [usuarioResolvioId], references: [id])
  historial       FallaEstacionHistorial[]

  @@index([estacionId, desde])
  @@index([desde])
  @@index([resueltaEn])
  @@map("fallas_estacion")
}

// Corregir `desde` cambia el tiempo de caída, un indicador de gestión, y no
// dejaba rastro (§15.5, mismo hueco que la decisión #3 dejó sin extender a
// este módulo). Guarda una foto de los tres campos corregibles antes de cada
// PATCH, no sólo el que cambió: es más simple que declarar qué campo fue y
// evita un historial que no explica el resto del estado en ese momento.
model FallaEstacionHistorial {
  id              BigInt   @id @default(autoincrement())
  fallaId         BigInt   @map("falla_id")
  causaFallaIdAnt Int      @map("causa_falla_id_ant")
  desdeAnt        DateTime @map("desde_ant") @db.Date
  observacionAnt  String?  @map("observacion_ant")
  usuarioId       Int      @map("usuario_id")
  modificadoEn    DateTime @default(now()) @map("modificado_en")

  falla   FallaEstacion @relation(fields: [fallaId], references: [id], onDelete: Cascade)
  usuario Usuario       @relation(fields: [usuarioId], references: [id])

  @@map("fallas_estacion_historial")
}

// ===== AUTORIZACIÓN =====

model Departamento {
  id     Int    @id @default(autoincrement())
  nombre String

  usuarios             Usuario[]
  superintendencias    SuperintendenciaDepartamento[]
  insumos              Insumo[]
  gerenciasRequiriente GerenciaRequiriente[]

  @@map("departamentos")
}

model Puesto {
  id     Int    @id @default(autoincrement())
  nombre String

  usuarios Usuario[]

  @@map("puestos")
}

model Usuario {
  id             Int     @id @default(autoincrement())
  nombre         String  @unique
  passwordHash   String  @map("password_hash")
  puestoId       Int     @map("puesto_id")
  departamentoId Int?    @map("departamento_id")
  supervisorId   Int?    @map("supervisor_id")
  bloqueado      Boolean @default(false)

  // Rol de sistema, ortogonal al cargo (`puesto`): administra cuentas, no
  // datos operativos. Va aparte de PUESTO porque PUESTO es el organigrama
  // real de PDVSA (decision #23) y la decision #31 deja al superadmin
  // explicitamente fuera del negocio ("no conoce el dominio").
  esSuperadmin Boolean @default(false) @map("es_superadmin")

  // Contrasena temporal: mientras `debeCambiarPassword` este en true la
  // sesion solo puede cambiar la contrasena; `passwordExpiraEn` es la
  // vigencia de la temporal (null = contrasena definitiva, no vence).
  debeCambiarPassword Boolean   @default(false) @map("debe_cambiar_password")
  passwordExpiraEn    DateTime? @map("password_expira_en")

  // Sello de revocacion: todo access token emitido ANTES de esta marca deja
  // de valer. Existe porque el access token es un JWT sin estado que la API
  // no puede retirar una vez emitido: revocar el refresh corta la renovacion,
  // pero el token que ya esta en manos de alguien sigue sirviendo hasta que
  // expire. Se sella al cambiar o reiniciar la contrasena, que es justo
  // cuando se sospecha que la sesion quedo en manos ajenas.
  sesionesInvalidasAntesDe DateTime? @map("sesiones_invalidas_antes_de")

  puesto       Puesto        @relation(fields: [puestoId], references: [id])
  departamento Departamento? @relation(fields: [departamentoId], references: [id])
  supervisor   Usuario?      @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinados Usuario[]     @relation("Supervision")

  superintendencias               SuperintendenciaDepartamento[]
  lecturasBalance                 LecturaBalance[]                @relation("LecturaBalanceDigitadaPor")
  lecturasBalanceEditadas         LecturaBalance[]                @relation("LecturaBalanceEditadaPor")
  lecturasBalanceHistorial        LecturaBalanceHistorial[]       @relation("LecturaBalanceHistorialCorrigio")
  lecturasBalanceHistorialEditado LecturaBalanceHistorial[]       @relation("LecturaBalanceHistorialEditadoPor")
  lecturasFuente                  LecturaFuente[]
  lecturasFuenteHistorial         LecturaFuenteHistorial[]
  quemasNacional                  QuemaNacional[]                 @relation("QuemaNacionalDigitadaPor")
  quemasNacionalEditadas          QuemaNacional[]                 @relation("QuemaNacionalEditadaPor")
  quemasNacionalHistorial         QuemaNacionalHistorial[]        @relation("QuemaNacionalHistorialCorrigio")
  quemasNacionalHistorialEditado  QuemaNacionalHistorial[]        @relation("QuemaNacionalHistorialEditadoPor")
  lecturasTransferencia           LecturaTransferencia[]
  lecturasTransferenciaHistorial  LecturaTransferenciaHistorial[]
  novedadesOperativa              NovedadOperativa[]
  fallasEstacionAbiertas          FallaEstacion[]                 @relation("FallaEstacionAbiertaPor")
  fallasEstacionResueltas         FallaEstacion[]                 @relation("FallaEstacionResueltaPor")
  fallasEstacionHistorial         FallaEstacionHistorial[]
  actividadesRegistro             ActividadRegistro[]
  actividadesRegistroHistorial    ActividadRegistroHistorial[]
  clavesIdempotencia              ClaveIdempotencia[]
  sesionesRefresh                 SesionRefresh[]
  logsLogin                       LogLogin[]
  logsIntentoNoAutorizado         LogIntentoNoAutorizado[]
  documentosRag                   DocumentoRag[]
  consultasRag                    ConsultaRag[]

  @@map("usuarios")
}

model SuperintendenciaDepartamento {
  id                Int @id @default(autoincrement())
  superintendenteId Int @map("superintendente_id")
  departamentoId    Int @map("departamento_id")

  superintendente Usuario      @relation(fields: [superintendenteId], references: [id])
  departamento    Departamento @relation(fields: [departamentoId], references: [id])

  @@unique([superintendenteId, departamentoId])
  @@map("superintendencias_departamento")
}

// ===== DOMINIO E: ACTIVIDADES / HORAS-HOMBRE =====

model Insumo {
  id             Int     @id @default(autoincrement())
  departamentoId Int     @map("departamento_id")
  nombre         String
  activo         Boolean @default(true)

  departamento      Departamento       @relation(fields: [departamentoId], references: [id])
  productosServicio ProductoServicio[]

  @@unique([departamentoId, nombre])
  @@map("insumos")
}

model ProductoServicio {
  id                   Int     @id @default(autoincrement())
  insumoId             Int     @map("insumo_id")
  nombre               String
  descripcionActividad String? @map("descripcion_actividad")
  activo               Boolean @default(true)

  insumo              Insumo              @relation(fields: [insumoId], references: [id])
  actividadesRegistro ActividadRegistro[]
  actividadesMeta     ActividadMeta[]

  @@unique([insumoId, nombre])
  @@map("productos_servicio")
}

model GerenciaRequiriente {
  id             Int     @id @default(autoincrement())
  departamentoId Int     @map("departamento_id")
  nombre         String
  activo         Boolean @default(true)

  departamento        Departamento        @relation(fields: [departamentoId], references: [id])
  actividadesRegistro ActividadRegistro[]

  @@unique([departamentoId, nombre])
  @@map("gerencias_requiriente")
}

model ActividadRegistro {
  id                    BigInt   @id @default(autoincrement())
  productoServicioId    Int      @map("producto_servicio_id")
  usuarioId             Int      @map("usuario_id")
  // Reutiliza RegionMtto (nullable = alcance nacional) - misma fuente de verdad que Mantenimiento.
  regionId              Int?     @map("region_id")
  fechaDesde            DateTime @map("fecha_desde") @db.Date
  fechaHasta            DateTime @map("fecha_hasta") @db.Date
  cantidad              Int
  // Nullable desde la decision #83: una tarea recien asignada (RECIBIDO)
  // todavia no tiene horas, y `null` dice "no se sabe" mientras que un cero
  // afirmaria que tomo cero horas. El workbook no lo contemplaba porque no
  // tiene flujo de asignacion: todas sus filas ya estan ejecutadas.
  hh                    Decimal? @db.Decimal(10, 2)
  gerenciaRequirienteId Int      @map("gerencia_requiriente_id")
  // Catálogo cerrado de 3 (RECIBIDO, EN PROCESO, FINALIZADO) - ERD lo declara `string`, se respeta tal cual.
  estatus               String
  detalle               String?

  productoServicio    ProductoServicio             @relation(fields: [productoServicioId], references: [id])
  usuario             Usuario                      @relation(fields: [usuarioId], references: [id])
  region              RegionMtto?                  @relation(fields: [regionId], references: [id])
  gerenciaRequiriente GerenciaRequiriente          @relation(fields: [gerenciaRequirienteId], references: [id])
  historial           ActividadRegistroHistorial[]

  @@index([fechaDesde, fechaHasta])
  @@map("actividades_registro")
}

// Corregir las horas de un registro ya cargado no dejaba rastro de quién lo
// hizo ni de cuál era el valor anterior, y esas horas alimentan indicadores
// de gestión (§14.7, mismo hueco que la decisión #3 dejó sin extender a este
// módulo). Guarda una foto de todos los campos corregibles del PATCH, no sólo
// el que cambió — mismo criterio que `FallaEstacionHistorial`. Los ids "Ant"
// son valores planos, no relaciones: son una foto de lo que fue, no una
// referencia viva que deba seguir existiendo.
model ActividadRegistroHistorial {
  id                       BigInt   @id @default(autoincrement())
  registroId               BigInt   @map("registro_id")
  productoServicioIdAnt    Int      @map("producto_servicio_id_ant")
  gerenciaRequirienteIdAnt Int      @map("gerencia_requiriente_id_ant")
  regionIdAnt              Int?     @map("region_id_ant")
  usuarioIdAnt             Int      @map("usuario_id_ant")
  fechaDesdeAnt            DateTime @map("fecha_desde_ant") @db.Date
  fechaHastaAnt            DateTime @map("fecha_hasta_ant") @db.Date
  cantidadAnt              Int      @map("cantidad_ant")
  hhAnt                    Decimal? @map("hh_ant") @db.Decimal(10, 2)
  estatusAnt               String   @map("estatus_ant")
  detalleAnt               String?  @map("detalle_ant")
  usuarioId                Int      @map("usuario_id")
  modificadoEn             DateTime @default(now()) @map("modificado_en")

  registro ActividadRegistro @relation(fields: [registroId], references: [id], onDelete: Cascade)
  usuario  Usuario           @relation(fields: [usuarioId], references: [id])

  @@map("actividades_registro_historial")
}

model ActividadMeta {
  id                 BigInt  @id @default(autoincrement())
  productoServicioId Int     @map("producto_servicio_id")
  anio               Int
  mes                Int
  cantidadMeta       Int     @map("cantidad_meta")
  hhMeta             Decimal @map("hh_meta") @db.Decimal(10, 2)

  productoServicio ProductoServicio @relation(fields: [productoServicioId], references: [id])

  @@unique([productoServicioId, anio, mes])
  @@map("actividades_meta")
}

// Idempotencia de los POST que no tienen una clave natural.
//
// En Despacho no hizo falta: todos los POST estan protegidos por un @@unique
// del propio dato (cliente+fecha+corte, fuente+fecha...), asi que un reintento
// choca con el constraint y devuelve 409. `ACTIVIDAD_REGISTRO` no tiene una
// clave natural -- dos asignaciones identicas de la misma tarea a la misma
// persona son legitimas-- y sus horas alimentan indicadores de gestion, asi
// que un duplicado silencioso infla un numero que alguien va a reportar.
//
// El caso que esto cierra y ningun boton deshabilitado cierra: el POST entro,
// la respuesta se perdio en un timeout, y el navegador no sabe si reintentar.
model ClaveIdempotencia {
  id             BigInt   @id @default(autoincrement())
  clave          String
  usuarioId      Int      @map("usuario_id")
  // sha256 de metodo + ruta + cuerpo. Reusar una clave con otro cuerpo es un
  // bug del cliente y tiene que fallar fuerte, no devolver la primera
  // respuesta a una peticion distinta.
  huellaPeticion String   @map("huella_peticion")
  // EN_CURSO mientras la peticion original corre; COMPLETADA con su respuesta
  // guardada. Un duplicado en vuelo recibe 409: dejarlo pasar porque el
  // primero "parece trabado" es justo cuando duplicar cuesta mas caro.
  estado         String
  estadoHttp     Int?     @map("estado_http")
  respuesta      Json?
  creadoEn       DateTime @default(now()) @map("creado_en")
  expiraEn       DateTime @map("expira_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  // El unico ES el mecanismo: se intenta insertar y se traduce la violacion,
  // en vez de consultar-y-despues-insertar, que es una carrera entre dos
  // reintentos simultaneos.
  @@unique([clave, usuarioId])
  @@index([expiraEn])
  @@map("claves_idempotencia")
}

// ===== SEGURIDAD (§3 - agregadas explícitamente, no dibujadas en el ERD original) =====

model SesionRefresh {
  id         BigInt    @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  // Nunca se guarda el refresh token en claro, solo su hash.
  tokenHash  String    @unique @map("token_hash")
  expiraEn   DateTime  @map("expira_en")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  revocadoEn DateTime? @map("revocado_en")
  ip         String?
  userAgent  String?   @map("user_agent")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones_refresh")
}

model LogLogin {
  id        BigInt   @id @default(autoincrement())
  // Nullable: un intento con un nombre de usuario inexistente no tiene FK válida.
  usuarioId Int?     @map("usuario_id")
  nombre    String
  exitoso   Boolean
  ip        String
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([creadoEn])
  @@map("logs_login")
}

model LogIntentoNoAutorizado {
  id        BigInt   @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  ruta      String
  motivo    String
  ip        String
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([creadoEn])
  @@map("logs_intento_no_autorizado")
}

// ===== FASE 2 — RAG (CONTEXTO_PROYECTO.md §16) =====
//
// Módulo transversal: consulta documentos de todos los departamentos. Lo que
// Prisma no sabe declarar va escrito a mano en la migración: la extensión
// unaccent, la configuración de búsqueda `sicog_es`, el CHECK "exactamente un
// origen" de chunks_rag y los índices HNSW y GIN.

enum TipoArchivoRag {
  PPTX
  DOCX
  PDF
  XLSX
}

enum EstadoDocumentoRag {
  PENDIENTE
  PROCESANDO
  LISTO
  ERROR
}

enum TipoChunkRag {
  TEXTO
  TABLA
  IMAGEN
  NOVEDAD
}

// Sólo el superadmin sube documentos (decisión #101). El archivo vive en el
// volumen de archivos, no en la base; acá queda la referencia.
model DocumentoRag {
  id           Int                @id @default(autoincrement())
  nombre       String
  tipoArchivo  TipoArchivoRag     @map("tipo_archivo")
  rutaOriginal String             @map("ruta_original")
  // Único: resubir el mismo archivo es un 409, no un duplicado en el corpus.
  hashSha256   String             @unique @map("hash_sha256")
  tamanoBytes  Int                @map("tamano_bytes")
  estado       EstadoDocumentoRag @default(PENDIENTE)
  // Cuándo lo tomó el worker: uno que lleva demasiado en PROCESANDO murió a
  // mitad y vuelve a PENDIENTE (§16.7).
  tomadoEn     DateTime?          @map("tomado_en")
  errorDetalle String?            @map("error_detalle")
  usuarioId    Int                @map("usuario_id")
  subidoEn     DateTime           @default(now()) @map("subido_en")
  procesadoEn  DateTime?          @map("procesado_en")

  usuario Usuario    @relation(fields: [usuarioId], references: [id])
  chunks  ChunkRag[]

  @@index([estado])
  @@map("documentos_rag")
}

// Cada chunk viene de un documento O de una novedad, nunca de los dos (CHECK
// a mano). `embedding` y `contenido_busqueda` los escribe el Repository con
// $executeRaw: Prisma no conoce ni vector ni tsvector.
model ChunkRag {
  id                BigInt                      @id @default(autoincrement())
  documentoId       Int?                        @map("documento_id")
  novedadId         BigInt?                     @unique @map("novedad_id")
  // Slide, página u hoja; null en novedades.
  origenDesde       Int?                        @map("origen_desde")
  origenHasta       Int?                        @map("origen_hasta")
  // Contexto para citar: "SISTEMA ANACO PUERTO ORDAZ — Data Técnica".
  seccion           String?
  tipo              TipoChunkRag
  contenido         String
  embedding         Unsupported("vector(768)")?
  modeloEmbedding   String                      @map("modelo_embedding")
  contenidoBusqueda Unsupported("tsvector")?    @map("contenido_busqueda")
  // Sólo novedades: md5 del contenido indexado, para detectar ediciones sin
  // tocar la tabla de Despacho.
  hashContenido     String?                     @map("hash_contenido")
  imagenRef         String?                     @map("imagen_ref")
  indexadoEn        DateTime                    @default(now()) @map("indexado_en")

  documento DocumentoRag?     @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  novedad   NovedadOperativa? @relation(fields: [novedadId], references: [id], onDelete: Cascade)

  @@index([documentoId])
  @@map("chunks_rag")
}

// Auditoría de consultas (§16.8): quién preguntó qué y qué se recuperó.
model ConsultaRag {
  id         BigInt    @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  pregunta   String
  chunkIds   BigInt[]  @map("chunk_ids")
  // Lo que se le contestó: sin esto, quien revisa un "no me sirvió" no sabe
  // qué dijo el asistente. Null si se cortó antes de escribir.
  respuesta  String?
  duracionMs Int?      @map("duracion_ms")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  // "¿Le sirvió?" de quien preguntó; opcional.
  util       Boolean?
  comentario String?
  valoradaEn DateTime? @map("valorada_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([creadoEn])
  @@index([util])
  @@map("consultas_rag")
}
