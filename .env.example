# Supabase Postgres (desarrollo). Sacar ambas cadenas del dashboard de Supabase
# en Project Settings > Database > Connection string.

# Pooled (pgbouncer, puerto 6543) - la usa la app (@sicog/db) en runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Directa (puerto 5432, sin pooler) - la necesita Prisma Migrate/introspección.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
