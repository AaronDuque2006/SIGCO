# Postgres local en Docker (desarrollo). Levantar con `docker compose up -d`
# (ver docker-compose.yml en la raíz) - crea la base `ctrl_operacional_gas`
# con pgvector ya incluido (imagen pgvector/pgvector:pg16).
#
# apps/api es un servidor Express de proceso persistente (no serverless), así
# que no hace falta pgbouncer - Prisma maneja su propio pool. DATABASE_URL
# (runtime) y DIRECT_URL (migraciones) apuntan a la misma conexión.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ctrl_operacional_gas"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ctrl_operacional_gas"

# Secreto de firma de JWT. Mínimo 32 caracteres: la API no arranca si falta o
# es más corto. Generar uno propio por ambiente, nunca reutilizar el de dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="generar-uno-de-al-menos-32-caracteres"
WEB_ORIGIN="http://localhost:3000"
PORT=4000

# --- Frontend (apps/web) ---
# Next sólo expone al navegador las variables con prefijo NEXT_PUBLIC_.
# Si se omite, el cliente asume http://localhost:4000.
NEXT_PUBLIC_API_URL="http://localhost:4000"
