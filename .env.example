# Supabase Postgres (desarrollo). Sacar la cadena de conexión del dashboard de
# Supabase en Project Settings > Database > Connection string > URI.
#
# apps/api es un servidor Express de proceso persistente (no serverless), así
# que no hace falta el pooler de pgbouncer - Prisma maneja su propio pool.
# DATABASE_URL (runtime) y DIRECT_URL (migraciones) apuntan a la misma
# conexión directa, puerto 5432.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
